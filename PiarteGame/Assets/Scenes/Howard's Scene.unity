--- !u!114 &1781020438
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1781020435}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a0ec989326a825449e98de53cf164d2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Silas
  playerName: Ashford
  conversationLines:
  - speaker: 1
    text: "Are you Old Silas? I heard you\u2019re someone who knows a lot about this
      place. Do you know how to get the relic stone from the pirates?"
    voiceLine: {fileID: 8300000, guid: 589ed3687608d144691be0ce3eb1e7a0, type: 3}
  - speaker: 0
    text: "You shouldn\u2019t be here. Turn back while you still can. The Captain
      doesn\u2019t show mercy to strangers."
    voiceLine: {fileID: 8300000, guid: ef1d3ae2378081e41bcfc9fd2ce39bf6, type: 3}
  - speaker: 1
    text: "I\u2019m here to take his stone. I\u2019m a pirate and I won\u2019t leave
      without it."
    voiceLine: {fileID: 8300000, guid: a6f603064c12da34399d5be8d05fb47f, type: 3}
  - speaker: 0
    text: "Hmph\u2026 then try, if you dare. After forty years of service, he treats
      me like a dog. I\u2019d love nothing more than to see you rob him blind.\r\n"
    voiceLine: {fileID: 8300000, guid: 0d80711e4ba1d7d4980e6e621ba89cb1, type: 3}
  - speaker: 0
    text: 'Listen carefully. The gate stays locked most of the time. But a wine cart
      is arriving right now, the guards will have to open it.

'
    voiceLine: {fileID: 8300000, guid: 65549ec52367a4a4197c1ea204b1ccc6, type: 3}
  - speaker: 0
    text: "When that gate starts to move, don\u2019t hesitate. Charge in and catch
      them off guard.\r\n"
    voiceLine: {fileID: 8300000, guid: f4fa862b9d99cf0468c836e915610265, type: 3}
  - speaker: 0
    text: "That\u2019s your chance. Give them hell."
    voiceLine: {fileID: 8300000, guid: 2414252a441b2fb44b94e4f590bfa8ba, type: 3}
  typingSpeed: 0.05
  slideSpeed: 0.3
  slideDistance: 300
  slideFromBottom: 1
