  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Marla
  playerName: Ashford
  conversationLines:
  - speaker: 1
    text: Have you heard anything about the relic stones?
    voiceLine: {fileID: 8300000, guid: 9213dac951ff06e448b5972978303a68, type: 3}
  - speaker: 0
    text: "The relic stones? No, I\u2019ve never heard of them."
    voiceLine: {fileID: 8300000, guid: c33057b175e882a45815367430ea5fcc, type: 3}
  - speaker: 0
    text: "You should try asking Old Silas. He\u2019s usually near the bonfire."
    voiceLine: {fileID: 8300000, guid: 710d885a9b14876409f34e485d26c268, type: 3}
  - speaker: 0
    text: "He\u2019s the oldest one here and knows a lot of history. He might be
      able to help.\r\n"
    voiceLine: {fileID: 8300000, guid: 84b343bf01e2f774abe7198f76bf5556, type: 3}
