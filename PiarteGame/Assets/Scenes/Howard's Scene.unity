--- !u!114 &172433207
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 172433205}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a0ec989326a825449e98de53cf164d2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Tomas
  playerName: Ashford
  conversationLines:
  - speaker: 1
    text: Do you know anything about the relic stones?
    voiceLine: {fileID: 8300000, guid: de406065467cd354e83488c3ca1fdaf7, type: 3}
  - speaker: 0
    text: "I don\u2019t know much about the relic stones, but I\u2019ve heard rumors."
    voiceLine: {fileID: 8300000, guid: d372b62b1b4dc384faa0cd15e9295549, type: 3}
  - speaker: 0
    text: "They say there\u2019s an unknown island filled with the undead."
    voiceLine: {fileID: 8300000, guid: 013c0c73eeffc0848863cb9b415b2458, type: 3}
  - speaker: 0
    text: "Those who go there\u2026 never come back alive."
    voiceLine: {fileID: 8300000, guid: b358b3cdd51bffd45883e7ba131b601a, type: 3}
  typingSpeed: 0.05
  slideSpeed: 0.3
  slideDistance: 300
  slideFromBottom: 1
  useCustomPosition: 0
