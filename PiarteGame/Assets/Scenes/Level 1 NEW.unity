  npcName: Brann
  playerName: Ashford
  conversationLines:
  - speaker: 1
    text: What about the pirates around here?
    voiceLine: {fileID: 8300000, guid: 2c8dd439a6f277c43a692a281e63b079, type: 3}
  - speaker: 0
    text: The pirates? Most of us used to be pirates once.
    voiceLine: {fileID: 8300000, guid: c5e8ad83ec869f948b6c314b2b3ae2fc, type: 3}
  - speaker: 0
    text: "Now we\u2019re nothing but slaves to them. I hate them."
